* text=auto eol=lf

# to move existing files into LFS:
# git add --renormalize .
*.onnx filter=lfs diff=lfs merge=lfs -text
openpilot/selfdrive/modeld/models/big_*_tinygrad.pkl filter=lfs diff=lfs merge=lfs -text
openpilot/sunnypilot/modeld_v2/models/*.pkl filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# 本 fork 的 LFS pushurl 指向上游 HF（只读），新增 wav 走普通 git 对象
openpilot/selfdrive/assets/sounds/audio_*.wav -filter -diff -merge -text
openpilot/selfdrive/assets/sounds/tici_disengaged.wav -filter -diff -merge -text

openpilot/selfdrive/car/tests/test_models_segs.txt filter=lfs diff=lfs merge=lfs -text
# updater ships as a plain git blob: the fork's LFS pushurl is read-only, and
# C3L/tici needs the touch-release-fixed zipapp rebuilt from source (24.7MB).
openpilot/common/hardware/comma/updater -filter -diff -merge binary
# CJK fonts as regular git objects (port of mouxangithub's approach): the
# official sunnypilot-lfs HuggingFace endpoint is read-only for forks, and
# 9.6MB of fonts is acceptable as plain blobs.
openpilot/selfdrive/assets/fonts/OpFont-*.otf -filter -diff -merge binary
openpilot/selfdrive/assets/fonts/NotoColorEmoji.ttf -filter -diff -merge binary

# Panda firmware images ride along in OTA as plain git blobs: the fork's LFS
# pushurl is read-only, and text/eol normalization must never touch their bytes.
*.bin.signed -filter -diff -merge -text binary

# BYD build spinner image as a plain git blob: this fork's LFS pushurl points
# to the upstream HF endpoint (read-only), so new PNGs cannot be pushed to LFS.
openpilot/sunnypilot/selfdrive/assets/images/spinner_byd_song.png -filter -diff -merge binary
