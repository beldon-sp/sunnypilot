--- /dev/null
+++ b/download_test.go
@@ -0,0 +1,55 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+)
+
+// TestDownloadBoundsParallel is a live-network test: it downloads the 2-degree tile grid around
+// Sacramento/Sierra (mostly land, so real HTTP 200s) and asserts every expected tile directory got
+// extracted files. Run with: go test -run TestDownloadBoundsParallel -v
+func TestDownloadBoundsParallel(t *testing.T) {
+	if testing.Short() {
+		t.Skip("network test")
+	}
+	t.Cleanup(func() {
+		_ = os.RemoveAll("tmp")
+		_ = os.RemoveAll(filepath.Join(GetBaseOpPath(), "offline"))
+	})
+
+	// DownloadIfTriggered normally pre-populates progress.LocationDetails before DownloadBounds runs
+	progress = DownloadProgress{
+		LocationsToDownload: []string{"TEST"},
+		LocationDetails:     map[string]*DownloadLocationDetail{"TEST": {}},
+	}
+
+	// adjustedBounds(38..41.5, -124..-118) on the 2-degree grid -> lat rows 38,40; lon cols -124,-122,-120
+	bounds := Bounds{MinLat: 38.0, MinLon: -124.0, MaxLat: 41.5, MaxLon: -118.0}
+	expected := [][2]int{{38, -124}, {38, -122}, {38, -120}, {40, -124}, {40, -122}, {40, -120}}
+
+	start := time.Now()
+	if err := DownloadBounds(bounds, "TEST"); err != nil {
+		t.Fatalf("DownloadBounds returned error: %v", err)
+	}
+	t.Logf("downloaded %d-tile block in %s (concurrency=%d)", len(expected), time.Since(start), downloadConcurrency())
+
+	for _, e := range expected {
+		dir := filepath.Join(GetBaseOpPath(), "offline", strconv.Itoa(e[0]), strconv.Itoa(e[1]))
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			t.Errorf("tile (%d,%d) dir missing: %v", e[0], e[1], err)
+			continue
+		}
+		if len(entries) == 0 {
+			t.Errorf("tile (%d,%d) dir empty", e[0], e[1])
+		}
+	}
+
+	// the tmp dir must be cleaned up after the run
+	if _, err := os.Stat(filepath.Join(GetBaseOpPath(), "tmp")); !os.IsNotExist(err) {
+		t.Errorf("tmp dir was not removed after download")
+	}
+}
